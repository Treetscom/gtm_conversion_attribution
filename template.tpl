___TESTS___

scenarios:
- name: Sends the pixel URL with encoded values and reports success
  code: |-
    runCode(mockData);

    assertThat(sentUrl).isEqualTo(
      'https://api.treets.com/api/intreeapi/gtm/checkout' +
      '?org_id=8747c7d6-ce7e-4821-b2b8-1605aa17fb25' +
      '&coupon=01YMGQFG&value=1299&currency=DKK');
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
- name: Encodes a voucher code containing & so it stays one parameter
  code: |-
    mockData.coupon = 'TREET123&SUMMER10';
    runCode(mockData);

    assertThat(sentUrl).contains('&coupon=TREET123%26SUMMER10&value=');
    assertApi('gtmOnSuccess').wasCalled();
- name: Encodes +, comma and space in a stacked voucher code
  code: |-
    mockData.coupon = 'coupon1+coupon2,coupon3 coupon4';
    runCode(mockData);

    assertThat(sentUrl).contains('&coupon=coupon1%2Bcoupon2%2Ccoupon3%20coupon4&value=');
- name: Empty voucher code sends nothing and reports success
  code: |-
    mockData.coupon = '';
    runCode(mockData);

    assertApi('sendPixel').wasNotCalled();
    assertApi('gtmOnSuccess').wasCalled();
- name: Undefined or whitespace-only voucher code sends nothing
  code: |-
    mockData.coupon = undefined;
    runCode(mockData);
    assertApi('sendPixel').wasNotCalled();

    mockData.coupon = '   ';
    runCode(mockData);
    assertApi('sendPixel').wasNotCalled();
    assertApi('gtmOnSuccess').wasCalled();
- name: Failed request calls gtmOnFailure
  code: |-
    mock('sendPixel', (url, onSuccess, onFailure) => {
      sentUrl = url;
      onFailure();
    });
    runCode(mockData);

    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
setup: |-
  const mockData = {
    orgId: '8747c7d6-ce7e-4821-b2b8-1605aa17fb25',
    coupon: '01YMGQFG',
    currency: 'DKK',
    value: 1299
  };

  let sentUrl;
  mock('sendPixel', (url, onSuccess, onFailure) => {
    sentUrl = url;
    onSuccess();
  });


