___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const sendPixel = require('sendPixel');
const logToConsole = require('logToConsole');
const encodeUriComponent = require('encodeUriComponent');
const makeString = require('makeString');

const enc = (v) => encodeUriComponent(makeString(v));

// Exit early on an empty voucher code: no order data is sent.
let coupon = '';
if (data.coupon !== undefined && data.coupon !== null) {
  coupon = makeString(data.coupon);
}

if (coupon.trim() === '') {
  logToConsole('Treets: no voucher code, pixel not sent.');
  data.gtmOnSuccess();
  return;
}

const pixelUrl = 'https://api.treets.com/api/intreeapi/gtm/checkout' +
  '?org_id=' + enc(data.orgId) +
  '&coupon=' + enc(coupon) +
  '&value=' + enc(data.value) +
  '&currency=' + enc(data.currency);

// Report the real outcome of the request.
sendPixel(
  pixelUrl,
  () => {
    logToConsole('Treets: pixel sent.', pixelUrl);
    data.gtmOnSuccess();
  },
  () => {
    logToConsole('Treets: pixel failed.', pixelUrl);
    data.gtmOnFailure();
  }
);


